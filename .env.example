# Supabase (auto-configured by Lovable Cloud)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# AI is served directly through Anthropic's API (backend only, via
# supabase/functions/_shared/llm-gateway.ts) — set as a Supabase Edge
# Function secret, never as a VITE_ var:
# ANTHROPIC_API_KEY=sk-ant-xxxxx (backend only)
# Never put a provider API key behind a VITE_ prefix — Vite inlines it into the browser bundle.

# Stripe (add via Lovable Cloud Secrets)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxx (backend only)
#
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx (backend only) -- powers supabase/functions/
# stripe-webhook, which keeps the `subscriptions` table in sync with Stripe in
# real time (cancellations, failed payments, plan changes) instead of waiting
# on check-subscription's next poll. One-time setup in the Stripe dashboard:
# Developers -> Webhooks -> Add endpoint -> URL:
#   https://<your-project-ref>.supabase.co/functions/v1/stripe-webhook
# -> listen for: customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted -> copy the generated signing secret here.
# Do this once for test mode and once for live mode (different secrets).

# Meta (Facebook/Instagram) ad account connection -- powers the "Connect Ad
# Account" flow in Settings (supabase/functions/meta-oauth-callback and
# fetch-meta-ad-performance). The whole OAuth flow is server-side; there is
# no client-side Facebook SDK and no VITE_ var for this -- all three of these
# are Supabase Edge Function secrets only.
#
# 1. Create an app at developers.facebook.com (type: Business).
# 2. Add the "Marketing API" product.
# 3. App Settings -> Basic: copy the App ID and App Secret below.
# 4. Marketing API -> Settings (or Facebook Login for Business) -> Valid
#    OAuth Redirect URIs -> add exactly:
#    https://<your-project-ref>.supabase.co/functions/v1/meta-oauth-callback
# 5. Request/enable the ads_read and business_management
#    permissions (Meta's App Review is only required once you need this to
#    work for ad accounts you don't personally own/admin -- your own
#    accounts work in development mode immediately).
# META_APP_ID=xxxxx (backend only)
# META_APP_SECRET=xxxxx (backend only)
#
# A separate, unrelated secret: the key connected_ad_accounts' OAuth tokens
# are encrypted with before being stored (AES-GCM, see
# supabase/functions/_shared/meta-crypto.ts). Generate a strong random value
# once with `openssl rand -base64 32` and never change it after real tokens
# exist -- rotating it makes every already-connected account's stored token
# undecryptable, forcing everyone to reconnect.
# AD_TOKEN_ENCRYPTION_KEY=xxxxx (backend only)

# Video rendering (HeyGen)
# HEYGEN_API_KEY=xxxxx (backend only)

# AI image generation (generate-post-visual) -- called directly, no gateway
# in front of either provider.
# OPENAI_API_KEY=sk-xxxxx (backend only) -- always required; the default
# text-to-image model (OpenAI's images/generations endpoint).
# GEMINI_API_KEY=xxxxx (backend only) -- required only when generating with a
# product-screen reference image, since compositing a real UI into a scene
# needs a multimodal image-in/image-out model (Google AI Studio -- Gemini API).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview (backend only, optional)
# -- override if Google renames/retires the default model; check
# ai.google.dev's current image-generation model list if generation starts
# failing with a 404/model-not-found error.

# Live search-demand grounding in strategy generation (fetchSearchDemand in
# supabase/functions/_shared/strategy-intel.ts) -- SEMrush's v3 Analytics API,
# called directly (the API key goes in the query string, not a header --
# that's how this API version authenticates). Fails soft (strategies still
# generate without this signal) if unset.
# SEMRUSH_API_KEY=xxxxx (backend only)

# Transactional email queue (process-email-queue), via Resend's HTTP API —
# supabase/functions/_shared/resend.ts. This is required for in-app emails
# like report-ready / usage notifications sent through send-transactional-email.
# The same key also powers send-gmail-reply (admin replies to contact-form
# submissions -- sent as a regular email via Resend, not through Gmail's own
# API/threading, since that path was Lovable-Cloud-connector-only).
# Sign up at resend.com, verify your sending domain's DNS (SPF/DKIM), then:
# RESEND_API_KEY=re_xxxxx (backend only)
#
# NOTE: Supabase Auth's OWN emails (signup confirmation, password reset,
# magic link, invite) are separate from the above and are NOT fixed by
# RESEND_API_KEY alone. This project previously had a custom "Send Email"
# Auth Hook (supabase/functions/auth-email-hook) built on Lovable Cloud's
# own email infrastructure (LOVABLE_API_KEY) for branded templates. Outside
# Lovable Cloud that hook has no working credential. The fastest fix:
# Supabase Dashboard → Authentication → Hooks → disable the "Send Email"
# hook if one is configured, then Dashboard → Authentication → Settings →
# SMTP Settings → configure Resend's SMTP relay. That makes Supabase's own
# built-in auth emails work immediately (using Supabase's default templates,
# not the custom React Email ones) with no code change required.

# Sentry Error Monitoring
VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# App Configuration
VITE_APP_URL=https://yourdomain.com
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI_CONTENT=true
VITE_ENABLE_SOCIAL_POSTING=true
