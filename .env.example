# Supabase (auto-configured by Lovable Cloud)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# AI is served through the Lovable AI Gateway (backend only).
# Never put a provider API key behind a VITE_ prefix — Vite inlines it into the browser bundle.

# Stripe (add via Lovable Cloud Secrets)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxx (backend only)
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx (backend only)

# Facebook/Instagram
VITE_FACEBOOK_APP_ID=xxxxx
# FACEBOOK_APP_SECRET=xxxxx (backend only)

# Sentry Error Monitoring
VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# App Configuration
VITE_APP_URL=https://yourdomain.com
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI_CONTENT=true
VITE_ENABLE_SOCIAL_POSTING=true
